		n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++) {
			arr[i]=sc.nextInt();
		}
		
		
		
	}
	public int missingno(int a[]) {
		 int n=a.length;
	        int sum=n*(n+1)/2;
	        int restSum=0;
	        for (int i = 0; i < a.length; i++) {
	            restSum+=a[i];
	        }
	        int missingNumber=sum-restSum;
	        return missingNumber;
		
	}

}
