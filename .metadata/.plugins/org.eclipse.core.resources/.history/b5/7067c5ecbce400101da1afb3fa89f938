package mixquestion;

import java.util.HashMap;

//Problem statement (simple words):
//You are given:
//An array of integers nums
//An integer target
//You need to find two different numbers in the array whose sum equals the target and return their indices.
//nums = [2, 7, 11, 15]
//target = 9
//👉 2 + 7 = 9
//so the answer is:
//text
//Copy code
//[0, 1]
//(because 2 is at index 0 and 7 is at index 1)
public class twosum {
	
	public static int[] returnsum(int target, int arr[]) {
		HashMap<Integer,Integer> num =new HashMap<>();
		for (int i=0; i<arr.length; i++) {
			int remaining = target-arr[i];
			if (num.containsKey(remaining)) {
				return new int[] {num.get(remaining),i};
				
			}
			num.put(arr[i],i);
		}
		return new int[]{};	
	}

	public static void main(String[] args) {
		int arr[]= {2,7,11,5,4,1};
		int target =9;
		int [] result=returnsum(target,arr);
		System.out.println("The indices are "+ result);
		

	}

}
