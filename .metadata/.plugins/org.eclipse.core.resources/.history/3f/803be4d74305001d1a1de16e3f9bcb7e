package coding;

public class missingno {

	public static void main(String[] args) {
		
	}
	public int missingno(int a[]) {
		 int n=a.length+1;
	        int sum=n*(n+1)/2;
	        int restSum=0;
	        for (int i = 0; i < a.length; i++) {
	            restSum+=a[i];
	        }
	        int missingNumber=sum-restSum;
	        return missingNumber;
		
	}

}
