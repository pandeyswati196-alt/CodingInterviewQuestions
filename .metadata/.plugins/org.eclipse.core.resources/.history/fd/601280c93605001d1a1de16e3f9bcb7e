package coding;

import java.util.Scanner;

public class question {

	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int max=0;
		int min=100;
		int arr[]=new int[n];
		for(int i=0;i<n;i++) {
			arr[i]=sc.nextInt();	
		}
		for(int i=0;i<n;i++) {
			if(max<arr[i]) {
				max=arr[i];
			}
			else if(min>arr[i]) {
				min=arr[i];
				System.out.println(min);

			}
			
		}
		System.out.println(max);
		
	}

}
